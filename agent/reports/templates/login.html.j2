<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sign in · {{ product_short }}</title>
  <style>{{ css | safe }}</style>
</head>
<body>
  <header>
    <p class="eyebrow">{{ product_short }}</p>
    <h1>Sign in</h1>
    <p class="sub">Use an Active Directory account that belongs to a VOCE role group.</p>
  </header>
  <main>
    <section class="panel login-card">
      {% if error %}<p class="login-error">{{ error }}</p>{% endif %}
      <form method="post" action="/login" class="form-grid">
        <label class="span-2">Account<input name="username" autocomplete="username" required placeholder="name@corp.example"></label>
        <label class="span-2">Password<input name="password" type="password" autocomplete="current-password" required></label>
        <button type="submit">Sign in</button>
      </form>
    </section>
  </main>
</body>
</html>
