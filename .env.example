# Copy to .env and fill in only the systems you use.
# Passwords can also be referenced from config/endpoints.yaml as ${ENV:NAME}.

VCO_HOST=127.0.0.1
VCO_PORT=8080
# The installer fills these with the default certificate. Point them at a company certificate to replace it.
VCO_SSL_CERTFILE=
VCO_SSL_KEYFILE=
# Optional. When Active Directory sign-in is on, scripts send this key instead of a person's password.
VCO_API_KEY=

# Optional Active Directory sign-in. Leave VCO_AUTH_MODE empty to keep the pages open.
# VCO_AUTH_MODE=ad
# VCO_AD_URL=ldaps://dc.corp.example:636
# VCO_AD_BASE_DN=DC=corp,DC=example
# VCO_AD_DOMAIN=corp.example
# VCO_AD_BIND_DN=
# VCO_AD_BIND_PASSWORD=
# VCO_AD_VERIFY_TLS=true
# VCO_AD_GROUP_ADMIN=VOCE-Admins
# VCO_AD_GROUP_OPERATOR=VOCE-Operators
# VCO_AD_GROUP_VIEWER=VOCE-Viewers
# VCO_SESSION_SECRET=
# VCO_SESSION_TTL_SECONDS=28800

VCO_CACHE_TTL_SECONDS=120
VCO_COLLECTOR_TIMEOUT_SECONDS=20
VCO_POWERSHELL_TIMEOUT_SECONDS=90
VCO_MAX_CONCURRENCY=8
VCO_ARIA_STAT_LIMIT=150
VCO_NSX_PORT_LOOKUP_LIMIT=150

# OpenAI-compatible chat endpoint. Leave the key empty to use the rules engine.
VCO_AI_BASE_URL=https://api.openai.com/v1
VCO_AI_API_KEY=
VCO_AI_MODEL=gpt-4o-mini
VCO_AI_TIMEOUT_SECONDS=4

# Teams incoming webhook. Notifications are skipped when this is empty.
VCO_TEAMS_WEBHOOK_URL=

# Power BI push dataset. CSV files are always written; push runs only when both are set.
VCO_POWERBI_TOKEN=
VCO_POWERBI_GROUP_ID=
VCO_POWERBI_DATASET_ID=
